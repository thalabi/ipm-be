<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:pro="http://www.liquibase.org/xml/ns/pro"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext 
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro 
        http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

    <!-- POSTGRES -->
    <changeSet id="alter-id-to-autoincrement-postgres" author="thalabi" dbms="postgresql">

        <dropDefaultValue tableName="sunshine_list" columnName="id"/>

        <sql>
            ALTER TABLE sunshine_list
            ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY;
        </sql>

        <sql>
            <![CDATA[
            SELECT setval(pg_get_serial_sequence('sunshine_list', 'id'), coalesce(max(id), 0) + 1, false)
            FROM sunshine_list;
            ]]>
        </sql>

    </changeSet>

    <!-- H2 -->
    <changeSet id="alter-id-to-autoincrement-h2" author="thalabi" dbms="h2">

        <dropDefaultValue tableName="sunshine_list" columnName="id"/>

        <sql>
            ALTER TABLE sunshine_list
            ALTER COLUMN id BIGINT AUTO_INCREMENT;
        </sql>

    </changeSet>

    <!-- POSTGRES ONLY: drop sequence if exists -->
    <changeSet id="drop-sequence-postgres" author="thalabi" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <sequenceExists sequenceName="sunshine_list_seq"/>
        </preConditions>
        <dropSequence sequenceName="sunshine_list_seq"/>
    </changeSet>

</databaseChangeLog>